# ==========================================
# qihuo 期货交易系统 - 环境变量模板
# ==========================================
# 复制为 .env 后填写真实值,切勿提交 .env 到 git
#
# 容器部署时,基础设施地址会被 docker-compose.yml 的 environment 覆盖。
# 此文件作为本地开发参考 + compose env_file 的来源(backend 必需变量都要存在)。

# ---------- PostgreSQL ----------
# 生产:容器名 postgres_db:5432(postgres:18 容器,加入 qihuo_qihuo-net 网络)
POSTGRES_USER=qihuo
POSTGRES_PASSWORD=
POSTGRES_DB=qihuo
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# ---------- TickData 历史 K线库（pg-tickdata：8亿级全周期历史，2005 起）----------
# 仅用于 K线图历史回溯（懒加载拖动加载）；未配置则自动降级到 HTTP/PG，不影响现网。
# 自备同类 PG 时填写（例：同机容器可填宿主 IP）。
# 密码勿提交，由各环境 .env 注入。
TICKDATA_POSTGRES_HOST=
TICKDATA_POSTGRES_PORT=5434
TICKDATA_POSTGRES_USER=
TICKDATA_POSTGRES_PASSWORD=
TICKDATA_POSTGRES_DB=tickdata

# ---------- Redis ----------
# 生产使用 qihuo 专属 Redis 服务，与其他项目隔离。
# Docker Compose 生产环境会注入内部 `redis:6379` 服务。
# 以下值仅供宿主机本地开发通过 qihuo 回环端口访问。
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0

# 该端口由 qihuo 专属使用，不要指向其他项目的 6379。
QIHUO_REDIS_HOST_PORT=6380
QIHUO_REDIS_HOST_HOSTNET=127.0.0.1

# ---------- Qdrant(向量库)----------
# 容器部署用服务名 qdrant（见 docker-compose）；裸机部署填自建实例地址
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AES-256-GCM 加密密钥（必填，缺失则加解密直接失败）----------
# 用于 API Key 加密存储；解码后必须为 32 字节。生成方式:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AES_ENCRYPTION_KEY=change_me_base64_32_bytes

# ---------- GitHub Token(AI Skills 商城集成)----------
GITHUB_TOKEN=

# ---------- 应用配置 ----------
# production:不自动建表(首次部署用 development 建表后切回)
APP_ENV=production
LOG_LEVEL=INFO
STOCK_REPLAY_ENABLED=false

# ---------- 实时行情渠道（管理端可覆盖；历史 K 线始终新浪，经 sina-bridge）----------
MARKET_DATA_CHANNEL_DEFAULT=sina

# ---------- 新浪行情源桥（唯一新浪出网点；compose profile sina-bridge）----------
# 多机部署时可选中心化：中心机启用桥（QIHUO_ENABLE_SINA_BRIDGE=1，宿主端口 8110），
# 其他机器的 .env 指向它，并可将 quote 推流双写到远端 Redis：
#   QIHUO_ENABLE_SINA_BRIDGE=1
#   QIHUO_SINA_REPLICATE_REDIS_URL=redis://192.0.2.10:6380/0
# 远端机器运行时 .env（切换后）：K 线/quote 兜底指向中心机的桥 + redis LAN 绑定供推流：
#   QIHUO_SINA_BRIDGE_BASE_URL=http://192.0.2.10:8110
#   QIHUO_REDIS_LAN_BIND=192.0.2.10
#   QIHUO_REDIS_LAN_PORT=6380
# 本机裸跑 backend（非容器）时指向桥的宿主映射地址
SINA_BRIDGE_BASE_URL=http://sina-bridge:8110

# ---------- 真实 CTP 行情桥（SimNow 已下线；启用需 compose profile ctp-md）----------
# 服务器运行时 .env 设 QIHUO_ENABLE_CTP_BRIDGE=1 + QIHUO_CTP_BRIDGE_CHANNEL=real_ctp
# 并配置 REAL_CTP_* 凭据后，live bridge 连接真实期货公司 CTP 行情
# QIHUO_ENABLE_CTP_BRIDGE=1
# QIHUO_CTP_BRIDGE_CHANNEL=real_ctp

# ---------- openctp 模拟（公众号注册，密码勿提交）----------
OPENCTP_BROKER_ID=9999
OPENCTP_PASSWORD=
OPENCTP_724_INVESTOR=
OPENCTP_SIM_INVESTOR=
OPENCTP_MD_FRONT_724=tcp://trading.openctp.cn:30011
# 仿真官方建议行情直连实盘前置；未配实盘 front 时可暂用 7×24
OPENCTP_MD_FRONT_SIM=tcp://trading.openctp.cn:30011
OPENCTP_APP_ID=
OPENCTP_AUTH_CODE=
OPENCTP_USER_PRODUCT_INFO=qihuo_oc

# ---------- 天勤 TqSdk（免费版历史分钟线，需快期账户，密码勿提交）----------
TQSDK_USER=
TQSDK_PASSWORD=

# ---------- 真实期货公司 CTP 行情（Level-1 一档免费；开户后向期货公司获取，密码勿提交）----------
# 行情前置地址，如 tcp://md.xxx.com:xxxx
REAL_CTP_MD_FRONT=
# 期货公司分配：BrokerID / 资金账号 / 密码
REAL_CTP_BROKER_ID=
REAL_CTP_INVESTOR_ID=
REAL_CTP_PASSWORD=
# 实盘 CTP 一般需要 AppID / AuthCode（期货公司柜台签发；无则留空）
REAL_CTP_APP_ID=
REAL_CTP_AUTH_CODE=
REAL_CTP_USER_PRODUCT_INFO=qihuo_real

# ---------- 自定义 CTP 行情前置（ctp_sim 渠道）----------
# 开源版不内置任何行情服务器地址：如有自己的 CTP 兼容行情前置，
# 在管理端「行情渠道监控」页填写 tcp://host:port（优先级高于此处）。
CTP_SIM_MD_FRONT=
CTP_SIM_BROKER_ID=9999
CTP_SIM_INVESTOR_ID=qihuo_sim
CTP_SIM_PASSWORD=
# 虚拟盘 7×24 bridge 换源（默认 openctp_724；设 ctp_sim 用自定义前置跑虚拟盘）
# CTP_BRIDGE_VIRTUAL_CHANNEL=ctp_sim

# ---------- K 线远端兜底源（可选）----------
# 本地所有 K 线源不可用（网络/封禁）时，从该服务器 /api/market/kline 中转历史。
# 例如另一台已配好数据源的部署：http://192.0.2.10:8002。
KLINE_REMOTE_BASE=

REGISTRATION_POLICY=open
STOCK_RESEARCH_JOBS_ENABLED=false
STOCK_LEGACY_SYNC_ENABLED=true
GP_JOBS_ENABLED=false
STOCK_EOD_ENABLED=false
STOCK_EOD_SYNC_ENABLED=false
STOCK_EOD_CATCHUP_ENABLED=false
STOCK_DAILY_ARCHIVE_ENABLED=false
